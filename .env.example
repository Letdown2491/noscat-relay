# noscat-relay configuration
#
# Copy this file to .env and edit. It is read on startup for local runs, by
# docker compose (env_file), and by systemd (EnvironmentFile).
#
# Uncommented lines are active. Commented (#) lines are optional: leave them
# off to use the built-in default.

# --- Required ---------------------------------------------------------------
# The public WebSocket URL clients use (behind Caddy: wss://your-domain).
# NIP-42 logins name the relay they are for; a login for any other URL is
# refused, so this must match exactly.
RELAY_URL="wss://relay.example.com"

# Who may use the relay: the mesh's members. Either a command whose output
# lists them (any npubs or hex pubkeys in it count; the output of
# `noscat mesh members` works as is), a file, or both. Re-read every
# MEMBERS_REFRESH_SECONDS; a failed or empty read keeps the previous list.
MEMBERS_COMMAND="$HOME/.local/bin/noscat mesh members"
# MEMBERS_FILE="/home/you/noscat-relay/members.txt"
# MEMBERS_REFRESH_SECONDS=60

# --- Recommended ------------------------------------------------------------
# Operator pubkey (hex), shown in NIP-11.
RELAY_PUBKEY=""

# --- Relay identity (defaults shown) ----------------------------------------
RELAY_NAME="noscat relay"
RELAY_DESCRIPTION="A members-only relay for a noscat mesh"

# --- Server and storage (defaults shown) -------------------------------------
# Plain WebSocket listen address; TLS comes from Caddy in front.
RELAY_PORT="127.0.0.1:3340"

# Group messages and gift wraps older than this are deleted. A device offline
# for longer cannot catch up and must rejoin.
RETENTION_DAYS=30

# Accepted clock skew for created_at, in minutes. Gift wraps may also be
# backdated up to two days (NIP-59).
ACCEPT_WINDOW_IN_MINUTES=15

# Events per minute per member, and per joining device and per IP.
MEMBER_RATE_PER_MINUTE=120
JOIN_RATE_PER_MINUTE=10

# Largest event content accepted, in KB.
MAX_CONTENT_KB=256

# --- Optional ---------------------------------------------------------------
# Only these groups (comma-separated #h routing ids, hex); empty = any group
# a member posts to.
# GROUPS=""

# Data directory (badger database).
# WORKING_DIR="./noscat-relay-data"

# Fallback contact (mailto: or https:), icon and banner URLs for NIP-11.
# RELAY_CONTACT=""
# RELAY_ICON=""
# RELAY_BANNER=""
